# Live mode never falls back to fixtures. Supply a provisioned sandbox.
STARTER_MODE=live
OFFERS_API_URL=
# Required: none or api-key. Application keys stay in this Node process.
OFFERS_APPLICATION_AUTH=none
OFFERS_API_KEY=
# Required: none or bearer. A bearer token is server-side for this read-only example.
OFFERS_USER_AUTH=none
OFFERS_BEARER_TOKEN=
STARTER_PORT=4300
