{
  "name": "@global-torque/invest-widgets",
  "version": "0.1.2",
  "description": "Host-controlled offer presentation and profile selection for Vue.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "exports": {
    ".": "./src/public/index.ts",
    "./offers": "./src/public/offers/index.ts",
    "./profiles": "./src/public/profiles/index.ts"
  },
  "sideEffects": [
    "**/*.vue",
    "**/*.css",
    "**/*.scss"
  ],
  "dependencies": {
    "@global-torque/ui-primitives": "0.1.2",
    "@global-torque/ui-kit": "0.1.2"
  },
  "peerDependencies": {
    "vue": "^3.5.39",
    "reka-ui": "^2.10.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-torque/vue-ui.git",
    "directory": "packages/invest-widgets"
  },
  "homepage": "https://github.com/global-torque/vue-ui#readme",
  "bugs": {
    "url": "https://github.com/global-torque/vue-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "pnpm run typecheck",
    "lint": "eslint --max-warnings=0 src",
    "test:run": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:run"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "jsdom": "29.0.1",
    "sass": "1.101.0",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.11",
    "vue": "3.5.39",
    "vue-tsc": "3.3.6",
    "reka-ui": "2.10.1"
  }
}
