{
  "name": "@global-torque/ui-kit",
  "version": "0.3.1",
  "description": "Generic Vue forms, images, URL state and composed controls.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "exports": {
    "./badge-tone": "./src/badge-tone/index.ts",
    "./breakpoints": "./src/breakpoints/index.ts",
    "./file-uploader": "./src/file-uploader/index.ts",
    "./filter": "./src/filter/index.ts",
    "./form": "./src/form/index.ts",
    "./form-validation": "./src/form-validation/index.ts",
    "./image": "./src/image/index.ts",
    "./pagination": "./src/pagination/index.ts",
    "./query-dialog": "./src/query-dialog/index.ts",
    "./styles/mixins": "./src/styles/mixins.scss",
    "./timeline": "./src/timeline/index.ts",
    "./url-sync": "./src/url-sync/index.ts",
    "./url-synced-tabs": "./src/url-synced-tabs/index.ts",
    "./styles": "./src/public-theme.css"
  },
  "sideEffects": [
    "**/*.vue",
    "**/*.css",
    "**/*.scss"
  ],
  "dependencies": {
    "@global-torque/ui-primitives": "0.2.0",
    "@internationalized/date": "^3.12.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "@lucide/vue": "^1.52.0",
    "@vueuse/core": "^15.0.0",
    "maska": "^3.2.2",
    "vue-input-otp": "^0.4.0"
  },
  "peerDependencies": {
    "vue": "^3.5.39",
    "reka-ui": "^2.10.1",
    "sass": "^1.101.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-torque/vue-ui.git",
    "directory": "packages/ui-kit"
  },
  "homepage": "https://github.com/global-torque/vue-ui#readme",
  "bugs": {
    "url": "https://github.com/global-torque/vue-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "pnpm run typecheck",
    "lint": "eslint --max-warnings=0 src",
    "test:run": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:run"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "jsdom": "29.1.1",
    "sass": "1.105.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12",
    "reka-ui": "2.11.0"
  }
}
