{
  "manifest": {
    "name": "@global-torque/ui-kit",
    "version": "0.3.1",
    "description": "Generic Vue forms, images, URL state and composed controls.",
    "type": "module",
    "license": "MIT",
    "engines": {
      "node": ">=22.12.0"
    },
    "files": [
      "dist",
      "README.md",
      "LICENSE",
      "NOTICE.md",
      "CHANGELOG.md",
      "SECURITY.md",
      "SUPPORT.md"
    ],
    "exports": {
      "./badge-tone": {
        "types": "./dist/badge-tone/index.d.ts",
        "import": "./dist/badge-tone/index.js"
      },
      "./breakpoints": {
        "types": "./dist/breakpoints/index.d.ts",
        "import": "./dist/breakpoints/index.js"
      },
      "./file-uploader": {
        "types": "./dist/file-uploader/index.d.ts",
        "import": "./dist/file-uploader/index.js"
      },
      "./filter": {
        "types": "./dist/filter/index.d.ts",
        "import": "./dist/filter/index.js"
      },
      "./form": {
        "types": "./dist/form/index.d.ts",
        "import": "./dist/form/index.js"
      },
      "./form-validation": {
        "types": "./dist/form-validation/index.d.ts",
        "import": "./dist/form-validation/index.js"
      },
      "./image": {
        "types": "./dist/image/index.d.ts",
        "import": "./dist/image/index.js"
      },
      "./pagination": {
        "types": "./dist/pagination/index.d.ts",
        "import": "./dist/pagination/index.js"
      },
      "./query-dialog": {
        "types": "./dist/query-dialog/index.d.ts",
        "import": "./dist/query-dialog/index.js"
      },
      "./styles/mixins": "./dist/styles/mixins.scss",
      "./timeline": {
        "types": "./dist/timeline/index.d.ts",
        "import": "./dist/timeline/index.js"
      },
      "./url-sync": {
        "types": "./dist/url-sync/index.d.ts",
        "import": "./dist/url-sync/index.js"
      },
      "./url-synced-tabs": {
        "types": "./dist/url-synced-tabs/index.d.ts",
        "import": "./dist/url-synced-tabs/index.js"
      },
      "./styles": "./dist/ui-kit.css"
    },
    "sideEffects": [
      "**/*.vue",
      "**/*.css",
      "**/*.scss"
    ],
    "dependencies": {
      "@global-torque/ui-primitives": "0.2.0",
      "@internationalized/date": "^3.12.4",
      "ajv": "^8.20.0",
      "ajv-formats": "^3.0.1",
      "@lucide/vue": "^1.52.0",
      "@vueuse/core": "^15.0.0",
      "maska": "^3.2.2",
      "vue-input-otp": "^0.4.0"
    },
    "peerDependencies": {
      "vue": "^3.5.39",
      "reka-ui": "^2.10.1",
      "sass": "^1.101.0"
    },
    "repository": {
      "type": "git",
      "url": "git+https://github.com/global-torque/vue-ui.git",
      "directory": "packages/ui-kit"
    },
    "homepage": "https://github.com/global-torque/vue-ui#readme",
    "bugs": {
      "url": "https://github.com/global-torque/vue-ui/issues"
    },
    "publishConfig": {
      "access": "public",
      "tag": "latest"
    }
  },
  "sourceFiles": [
    "./dist"
  ],
  "documentationFiles": [
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "readme": "PUBLIC_API.md"
}
